# Copy to .env and adjust as needed. Never commit the real .env.

# DATABASE_URL=sqlite:///database/dairytech.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dairytech

DATABASE_ECHO=false
LOG_LEVEL=INFO
APPEARANCE_MODE=System
COLOR_THEME=blue

# Required in any real deployment (Render, etc.) — without it, a host with
# an ephemeral disk regenerates this on every restart and invalidates every
# tester's login token. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=

# --- AI Dairy Assistant (Phase 1) ---
# Required for POST /assistant/ask — retrieval (embeddings) stays local;
# this key is only used for the final answer-generation call, sent the
# question plus a few retrieved book passages (never whole books or farm
# data). Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Optional — overrides the local embedding model. Defaults to a small
# Japanese-specific model chosen to fit a free-tier host's RAM; see
# docs/ARCHITECTURE.md before changing this.
# EMBEDDING_MODEL_NAME=cl-nagoya/ruri-v3-30m

# Optional — where `scripts/ingest_book.py` looks for PDFs by default.
# BOOKS_DIR=data/books
